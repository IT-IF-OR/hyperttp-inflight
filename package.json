{
  "name": "@hyperttp/inflight",
  "version": "2.0.0",
  "description": "Request collapsing and de-duplication plugin for Hyperttp client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./dist/package.json"
  },
  "author": "dirold2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-inflight.git"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.3.0"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@hyperttp/types": "^0.3.0",
    "@types/bun": "latest",
    "@types/node": "latest",
    "typescript": "^7.0.2",
    "vitest": "latest",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "build": "tsc && esbuild 'dist/**/*.js' --outdir=dist --allow-overwrite --minify --sourcemap && d-build",
    "dist": "d-dist",
    "deploy": "npm run build && npm run dist",
    "pub": "d-publish",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests vitest.config.ts",
    "lint:fix": "oxlint src tests vitest.config.ts --fix",
    "format": "oxfmt src tests vitest.config.ts",
    "format:check": "oxfmt src tests vitest.config.ts --check",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  }
}
